<%= render layout: 'shared/primary_layout' do %>
  <h1 class="sign-in-heading">Edit Profile</h1>

  <%= form_with model: @user, url: profile_path, method: :patch, local: true do |f| %>
    <div class="form-group">
      <%= f.label :first_name %>
      <%= f.text_field :first_name %>
    </div>

    <div class="form-group">
      <%= f.label :last_name %>
      <%= f.text_field :last_name %>
    </div>

    <div class="form-group">
      <%= f.label :birthday %>
      <%= f.date_select :birthday, start_year: 1900, end_year: Time.now.year %>
    </div>

    <div class="form-group">
      <%= f.label :email %>
      <%= f.email_field :email %>
    </div>

    <div class="form-group">
      <%= f.label :username %>
      <%= f.text_field :username %>
    </div>

    <div class="form-group">
      <%= f.label :password %>
      <%= f.password_field :password, autocomplete: "new-password" %>
    </div>

    <div class="form-group">
      <%= f.label :password_confirmation %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
    </div>

    <div class="form-group">
      <%= f.label :likes, "Likes (up to 5)" %>
      <% 5.times do |i| %>
        <%= f.text_field "likes[]", value: @user.likes[i] %>
      <% end %>
    </div>

    <div class="form-group">
      <%= f.label :dislikes, "Dislikes (up to 5)" %>
      <% 5.times do |i| %>
        <%= f.text_field "dislikes[]", value: @user.dislikes[i] %>
      <% end %>
    </div>

    <div class="form-group">
      <%= f.label :general_budget %>
      <%= f.number_field :general_budget, step: 1 %>
    </div>

    <div class="form-group">
      <%= f.label :wishlist, "Wishlist Items (comma separated)" %>
      <%= f.text_area :wishlist %>
    </div>

    <div class="form-group">
      <%= f.label :avoid_list, "Avoid Items (comma separated)" %>
      <%= f.text_area :avoid_list %>
    </div>

    <%= f.submit "Update Profile", class: "nav-button" %>
  <% end %>
<% end %>
