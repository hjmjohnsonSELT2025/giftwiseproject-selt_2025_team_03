<%= render "shared/sidebar_layout" %>
<main class="main-content">
  <div class="top-bar">
    <h1 class="page-title">AI Gift Suggestions</h1>
    <%= render "shared/profile_dropdown" %>
  </div>

  <div class="card">
    <%= form_with url: event_recipient_ai_suggestions_path(@event_recipient), method: :post, data: { turbo: false } do %>
      <label class="input-label">Prompt</label>
      <textarea name="prompt" class="input-field" rows="4"
        placeholder="e.g., 5 gift ideas under $30 for someone who likes hiking and coffee. Include links."></textarea>

      <div style="margin-top:12px; display:flex; gap:10px;">
        <button class="login-button" type="submit">Get suggestion</button>
        <%= link_to "Back", event_path(@event_recipient.event), class: "login-button secondary" %>
      </div>
    <% end %>
  </div>

  <div style="margin-top:18px;">
    <% if @gift_ideas.any? %>
      <% @gift_ideas.each do |g| %>
        <div class="card" style="margin-bottom:12px;">
          <div style="display:flex; justify-content:space-between; gap:12px;">
            <div>
              <div style="font-weight:700;"><%= g.title %></div>
              <div style="opacity:.8;">$<%= g.price.to_f %></div>
            </div>
            <% if g.url.present? %>
              <%= link_to "Open", g.url, target: "_blank", rel: "noopener", class: "login-button secondary" %>
            <% end %>
          </div>

          <% if g.notes.present? %>
            <pre style="white-space:pre-wrap; opacity:.9; margin-top:10px;"><%= g.notes %></pre>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <div class="hint">No AI suggestions yet.</div>
    <% end %>
  </div>
</main>
