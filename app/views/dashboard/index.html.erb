<div class="dashboard-container">
  <!-- Sidebar -->
  <aside class="sidebar">
    <div class="logo">
      <div class="logo-icon"></div>
      <span>GiftWise</span>
    </div>

    <nav>
      <ul class="nav-menu">
        <li class="nav-item active">
          <span>Dashboard</span>
        </li>
        <li class="nav-item">
          <span>Events</span>
        </li>
        <li class="nav-item">
          <span>Recipients</span>
        </li>
        <li class="nav-item">
          <span>Gift Ideas</span>
        </li>
        <li class="nav-item">
          <span>Purchases</span>
        </li>
        <li class="nav-item">
          <span>Settings</span>
        </li>
      </ul>
    </nav>
  </aside>

  <!-- Main Content -->
  <main class="main-content">
    <!-- Top Bar -->
    <div class="top-bar">
      <h1 class="page-title">Dashboard</h1>
      <div class="user-profile">
        <div class="user-info">
          <div class="user-name"><%= @user.first_name %> <%= @user.last_name %></div>
          <div class="user-role">Gift Coordinator</div>
        </div>
        <div class="user-avatar"></div>
      </div>
    </div>

    <!-- Stats Grid -->
    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-icon"></div>
        <div class="stat-value"><%= @total_events %></div>
        <div class="stat-label">Active Events</div>
      </div>
      <div class="stat-card">
        <div class="stat-icon"></div>
        <div class="stat-value"><%= @total_recipients %></div>
        <div class="stat-label">Recipients</div>
      </div>
      <div class="stat-card">
        <div class="stat-icon"></div>
        <div class="stat-value"><%= @gifts_purchased_percentage %>%</div>
        <div class="stat-label">Gifts Purchased</div>
      </div>
      <div class="stat-card">
        <div class="stat-icon"></div>
        <div class="stat-value">$<%= number_with_delimiter(@total_spent.round, delimiter: ',') %></div>
        <div class="stat-label">Total Spent</div>
      </div>
    </div>
  </main>
</div>