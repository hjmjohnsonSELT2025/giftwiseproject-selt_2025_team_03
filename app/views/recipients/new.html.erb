<div class="page">
  <%= render "shared/sidebar_layout" %>
  <div class="main-content recipients-new">
    <div class="page-top-bar">
      <h1 class="page-title">Add New Recipient</h1>
      <%= render "shared/profile_dropdown" %>
    </div>
    <% unless params[:user_id].present? %>
      <div class="recipients-new-tabs">
        <%= render "users/tabs_layout" %>
      </div>
    <% end %>
    <div class="recipients-new-form">
      <%= render "form" %>
    </div>
  </div>
</div>
