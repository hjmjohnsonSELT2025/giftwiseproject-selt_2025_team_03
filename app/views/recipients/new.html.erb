<%= render layout: 'shared/primary_layout' do %>
    <%= form_with model: @recipient, url: recipients_path, method: :post, class: "create-recipient" do |r| %>
    <div class='decorative-line'></div>
    <h1 class='heading'>Add New Recipient</h1>
    <%# Name (Required) %>
    <div class='input-group'>
        <%= r.label :name, "Name", name: "recipient[name]", class: "input-label" %>
        <%= r.text_field :name, max_length: 30, placeholder: "Mom", class: "input-field required" %>
    </div>

    <%# BDay  (optional) %>
    <div class='input-group'>
        <%= r.label :birthday, "Birthday", name: "recipient[birthday]" %>
        <%= r.date_field :birthday, class: "input-field" %>
    </div>

    <%# Relationship (optional) %>


    <%# Likes (optional) %>

    <%# Dislikes (optional) %>

    <%# Options %>
    <div class='footer'>
        <%= r.submit "Save"%>
        <%= link_to "Cancel", recipients_path %>
    </div>
    <% end %>
    <% end %>


