<%= render "shared/sidebar_layout" %>

<main class="main-content" data-controller="new-recipient">
  <div class="top-bar">
    <h1 class="page-title">Add New Recipient</h1>
    <%= render "shared/profile_dropdown" %>
  </div>

  <section class="recipient-form-section">
    <div class="form-card recipient-form-card">
      <%= form_with model: @recipient,
                    url: recipients_path,
                    method: :post,
                    class: "create-recipient recipient-form" do |r| %>

        <div class="decorative-line"></div>

        <div class="form-header">
          <h2 class="heading">Recipient details</h2>
          <p class="form-subtitle">
            Save a few key details now so it’s easier to pick gifts later.
          </p>
        </div>

        <div class="form-grid">
          <%# Name (required) %>
          <div class="input-group required">
            <%= r.label :name, "Name", class: "input-label" %>
            <%= r.text_field :name,
                  maxlength: 50,
                  placeholder: "Mom, Alex, Grandpa Jim…",
                  class: "input-field required",
                  required: true %>
          </div>

          <%# Relationship %>
          <div class="input-group">
            <%= r.label :relationship, "Relationship (optional)", class: "input-label" %>
            <%= r.select :relationship,
                  options_for_select(
                    ["Parent", "Sibling", "Partner", "Child", "Relative",
                     "Friend", "Coworker", "Other"],
                    @recipient.relationship),
                  { include_blank: "Select relationship" },
                  class: "input-field", id: "relationship-selector" %>
            <div class='input-group hidden' id='other-relationship-wrap'>
              <%= r.text_field :relationship_other, maxlength: 50, placeholder: "Other", class: "input-field" %>
            </div>
          </div>

          <%# Birthday %>
          <div class="input-group">
            <%= r.label :birthday, "Birthday", class: "input-label" %>
            <%= r.date_field :birthday, class: "input-field" %>
          </div>

          <%# Likes %>
          <div class="input-group full-width">
            <%= r.label :likes, "Interests & likes", class: "input-label" %>
            <%= r.text_area :likes,
                  rows: 3,
                  placeholder: "Hobbies, favorite stores, colors, categories of gifts…",
                  class: "input-field" %>
          </div>

          <%# Dislikes %>
          <div class="input-group full-width">
            <%= r.label :dislikes, "Avoid", class: "input-label" %>
            <%= r.text_area :dislikes,
                  rows: 2,
                  placeholder: "Anything they don’t like or can’t use",
                  class: "input-field" %>
          </div>
        </div>

        <div class="form-footer">
          <%= r.submit "Save recipient", class: "button primary" %>
          <%= link_to "Cancel", recipients_path, class: "button" %>
        </div>
      <% end %>
    </div>
  </section>
</main>
