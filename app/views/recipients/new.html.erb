<%= render "shared/sidebar_layout" %>

<main class="main-content">
    <div class="top-bar">
        <h1 class="page-title">Add New Recipient</h1>
        <%= render "shared/profile_dropdown" %>
    </div>

    <div class="form-card">
        <%= form_with model: @recipient, class: "create-recipient" do |r| %>
        <div class="decorative-line"></div>
    <h1 class="heading">Add New Recipient</h1>

    <%# Name (required) %>
    <div class="input-group">
        <%= r.label :name, "Name", class: "input-label" %>
        <%= r.text_field :name,
            maxlength: 30,
            placeholder: "Mom",
            class: "input-field required" %>
    </div>

     <%# Birthday (optional) %>
    <div class="input-group">
        <%= r.label :birthday, "Birthday", class: "input-label" %>
        <%= r.date_field :birthday, class: "input-field" %>
    </div>

    <%# Relationship  %>

    <div class="footer">
        <%= r.submit "Save", class: "primary-button" %>
        <%= link_to "Cancel", recipients_path, class: "link-button" %>
    </div>
<% end %>
</div>
</main>
