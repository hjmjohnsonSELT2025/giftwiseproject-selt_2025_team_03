<%= turbo_frame_tag dom_id(recipient) do %>
    <div class='recipient-container view'>
        <div class='col1'>
            <div class='recipient-header'>
                <div class='name'><%= recipient.name %></div>
                <div class='ri'><%= recipient.relationship.presence || '' %></div>
            </div>

            <div class='events'>
                <div class='detail-label'>Events</div>
                <div class='details'>
                    <% recipient.events.each do |event| %>
                        <div class='value'><%= "#{event.name}"%></div>
                    <% end %>
                </div>
            </div>
        </div>

        <div class='col2'>
            <div class='likes'>
                <div class='detail-label'>Likes</div>
                <div class='details'>
                    <%= recipient.likes %>
                </div>
            </div>
        

            <div class='dislikes'>
                <div class='detail-label'>Dislikes</div>
                <div class='details'>
                    <%= recipient.dislikes %>
                </div>
            </div>

        </div>
        <div class='options'>
            <%= link_to edit_recipient_path(recipient), class: "option" do %>
                <%= icon :edit, class: "icon" %>
            <% end %>
            
            <%= link_to recipient_path(recipient),
                class: "option",
                data: { turbo_method: :delete, turbo_confirm: "Delete #{recipient.name}?" } do %>
                <%= icon :trash, class: "icon" %>
            <% end %>
        </div>
    </div>
<% end %>