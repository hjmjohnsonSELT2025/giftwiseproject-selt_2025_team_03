<%# New/update form for recipient %>
<%= form_with model: @recipient, 
              url: recipients_path,
              method: :post,
              class: "patch-recipient" do |f| %>
    <div class='decorative-line'></div>
    <div class='form-header'>
        <h2 class='heading'>Recipient details</h2>
    </div>

    <%# Name %>
    <div class='input-group required'>
        <%= f.label :name, "Name" %>
        <%= f.text_field :name, class: "input-field" %>
    </div>

    <%# Relationship %>
    <div class='input-group'>
        <%= f.label :relationship, "Relationship (optional)", class: "input-label" %>
        <%= f.select :relationship,
              options_for_select(
                ["Parent", "Sibling", "Partner/Spouse", "Child", "Relative",
                "Friend", "Coworker", "Other"], @recipient.relationship),
                {include_blank: "Select relationship" },
                class: "input-field", id: "relationship-selector" 
        %>
        <div class='input-group hidden' id='other-relationship-wrap'>
            <%= f.text_field :relationship_other, maxlength: 50, placeholder: "Other", class: "input-field" %>
        </div>
    </div>

    <%# Events %>
    <div class='input-group'>
        <fieldset>
            <legend>Events</legend>
            <% if @events.present? %>
                <div class='events-grid'>
                    <%= f.collection_check_boxes :event_ids, @events, :id, :name do |b| %>
                        <label class='checkbox-row'>
                            <%= b.check_box%>
                            <span><%= b.text %></span>
                        </label>
                    <% end %>
                </div>
            <% else %>
                <p class='hint'>No events yet.</p>
            <% end %>
        </fieldset>
    </div>

    <%# Birthday %>
    <div class='input-group'>
        <%= f.label :birthday, "Birthday", class: "input-label" %>
        <%= f.date_field :birthday, class: "input-field" %>
    </div>

    <%# Likes %>
    <div class="input-group full-width">
        <%= f.label :likes, "Interests & likes", class: "input-label" %>
        <%= f.text_area :likes,
                rows: 3,
                placeholder: "Hobbies, favorite stores, colors, categories of gifts...",
                class: "input-field" %>
    </div>

    <%# Dislikes %>
    <div class='input-group full-width'>
        <%= f.label :dislikes, "Dislikes", class: "input-label" %>
        <%= f.text_area :dislikes, 
                rows: 3, 
                placeholder: "Least favorite activities, stores, ...", 
                class: "input-field" %>
    </div>
    <div class='form-footer'>
        <%= link_to "Cancel", recipients_path, class: "button" %>
        <%= f.submit class: "buttom primary" %>
    </div>
<% end %>


    
