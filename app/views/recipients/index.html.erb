<%= render "shared/sidebar_layout" %>

<main class="main-content">
    <div class="top-bar">
        <h1 class="page-title">Recipients</h1>
        <%= render "shared/profile_dropdown" %>
    </div>

    <div class="view-options container">
        <!-- id='search-recipients', class='input-field' -->
        <%= render "shared/search", 
            endpoint: recipients_path, 
            method: :get, 
            data: { turbo_frame: "recipients-list" }, 
            class: "search-form", 
            placeholder: "Search for recipient..." %>
    </div>
    <%= turbo_frame_tag "recipients_list" do %>
        <% if @recipients.none? %>
            <div class='empty-content hint'>No recipients yet. Add your first recipient by clicking the '+'!</div>
        <% else %>
            <%= render @recipients %>
        <% end %>
    <% end %>
</main>

<%= link_to "+", new_recipient_path, class: "add-button" %>
