    <%= render "shared/sidebar_layout" %>

    <main class="main-content">
    <div class="top-bar">
    <h1 class="page-title">Recipients</h1>
    <%= render "shared/profile_dropdown" %>
    </div>

    <div class="view-options container">
    <input 
        type="text" 
        placeholder="Search for recipient" 
        id="search-recipients" 
        class="input-field"
        data-search-url="<%= search_recipients_path %>"
        data-recipients-target="search"
        data-action="input->recipients#onSearch"
    >
    <div class="container">
    </div>
    </div>
    <%= render @recipients %>
</main>

<%= link_to "+", new_recipient_path, class: "add-button" %>
