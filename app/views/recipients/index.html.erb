<%# Render primary layout %>
<%= render layout: 'shared/primary_layout' do %>
    <%# Header %>
    <div class='decorative-line'></div>
    <div class='header'>
        <h1>Recipients</h1>
    </div>

    <%# Body %>
    <div class='container'>
        <%# Options to filter view based on events %>
        <div class='container' id='filter-container'>
            <p>Filter options</p>

        </div>
        <div class='container' id='list-container'>
            <template id='recipient-row-template'>
                <tr>
                    <td class='first-name'></td>
                    <td class='last-name'></td>
                    <td class='relationship'></td>
                    <td class='status'></td>
                </tr>
            </template>
            <table id='recipient-table'>
                <tr>
                    <th>First name</th>
                    <th>Last name</th>
                    <th>Relationship</th>
                    <th>Status</th>
                </tr>
            </table>
        </div>
    </div>
<% end %>