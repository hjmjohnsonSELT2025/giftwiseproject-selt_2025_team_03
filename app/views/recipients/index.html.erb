<%= render "shared/sidebar_layout" %>
<main class='main-content'>
    <div class='top-bar'>
        <h1 class='page-title'>Recipients</h1>
        <%= render 'shared/profile_dropdown' %>
    </div>
    <div class='view-options container'>
        <input 
          type='text' 
          placeholder='Search for recipient' 
          id='search-recipients' 
          class='input-field'
          data-search-url='<%= search_recipients_path %>'
        >
        <div class='container'>
            <div class='view-button' id='filter-option'>
                [Filter]
            </div>
            <div class='view-button' id='sort-option'>
                [Sort]
            </div>
        </div>
    </div>
    <%# Template for a recipient card %>
    <template id='recipient-card'>
        <div class='recipient-container'>
            <div class='recipient-header'>
                <div class='ri' name='name'></div>
                <div class='ri' name='relationship'></div>
            </div>
            <div class='recipient-body'>
                <div class='recipient-details'>
                    <div class='detail-row'>
                        <div class='detail-label'>Events</div>
                        <div class='detail-value'>
                            <div class='ri' name='events'></div>
                        </div>
                    </div>
                    <div class='detail-row'>
                        <div class='detail-label'>Interests</div>
                        <div class='detail-value'>
                            <div class='ri' name='likes'></div>
                        </div>
                    </div>
                </div>
                <div class='recipient-options'>
                    <a class='view-button edit-link' href='#'><%= image_tag "edit.png", alt: "Edit recipient", class: "icon" %></a>
                    <a class='view-button delete-link' href='#'><%= image_tag "trash.png", alt: "Delete recipient", class: "icon" %></a>
                </div>
            </div>
        </div>
    </template>
    <%# Node for template card to be rendered at %>
    <div id='recipient-results' class='recipients-list'>
    </div>
</main>
<button class='add-button' href="<%= new_recipient_path %>">+</button>
<%= javascript_import_module_tag 'controllers/recipients/search' %>
<%# 
Events:      Christmas, Mom's Birthday
Interests:   Jewelry, family time, gardening, plants
 %>