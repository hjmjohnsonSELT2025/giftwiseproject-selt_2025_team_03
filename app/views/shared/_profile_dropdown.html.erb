<details class='profile-dropdown' id='profile-dropdown-menu'>
    <summary class='user-profile' id='profile-link' aria-haspopup='menu'>
        <div class='user-info'>
        <div class='user-name'><%= @current_user.first_name %> <%= @current_user.last_name %></div>
        <div class='user-role'>Gift Coordinator</div>
        </div>
        <div class='user-avatar'></div>
    </summary>
    <div class='menu' role='menu' aria-labelledby='profile-link' id='profile-menu-details'>
        <div class='menu-options'>
        <a class='menu-option-item stat-card' role='menuitem' href='%<%= users_profile rescue "/" %>'>Proile Settings</a>
        <%= link_to "Logout", logout_path,
            data: { turbo_method: :delete },
            class: "menu-option-item stat-card",
            role: "menuitem" %>
        </div>
    </div>
</details>
<%= javascript_import_module_tag "controllers/shared/profile-dropdown" %>