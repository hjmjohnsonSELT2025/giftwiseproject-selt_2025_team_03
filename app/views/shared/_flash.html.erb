<% flash.each do |type, payload| %>
    <% next if payload.blank? %>
    <% data = payload.is_a?(Hash) ? payload.symbolize_keys : { text: payload } %>
    <% text = data[:text].to_s %>
    <% next if text.blank? %>
    <% timeout = (data[:timeout] || 2000).to_i %>
    <% ok_action = data[:ok_action].presence %>
    <div class='flash flash--<%= type %>'
         data-controller='flash'
         data-flash-timeout-value="<%= timeout %>">

        <div class='flash__body'>
            <div class='flash__title'><%= type.to_s.upcase %></div>
            <div class='flash__message'><%= text %></div>
        </div>
        <button type='button' 
                class='flash__close' 
                aria-label='Dismiss' 
                data-action="click->flash#close">
                OK</button>
    </div>
<% end %>
