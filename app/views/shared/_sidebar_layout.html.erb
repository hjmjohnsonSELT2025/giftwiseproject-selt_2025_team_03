<!-- Sidebar -->
<aside class="sidebar">
<div class="logo">
    <div class="logo-icon"></div>
    <span>GiftWise</span>
</div>
<% page = get_active_nav_item %>
<% Rails.logger.debug page.to_s %>

<nav>
    <ul class="nav-menu">
    <%# Dashboard %>
    <%= link_to dashboard_path, class: 'nav-link', id: "dashboard-link" do %>
        <li class="nav-item <%='active' if page == :dashboard%>">
            <span>Dashboard</span>
        </li>
    <% end %>


    <%# Events %>
    <%= link_to events_path, class: 'nav-link', id: "events-link"  do %>
        <li class="nav-item <%='active' if page == :events %>">
            <span>Events</span>
        </li>
      <% end %>


    <%# Recipients %>
    <%= link_to recipients_path, class: "nav-link", id: "recipients-link" do %>
        <li class="nav-item <%='active' if page == :recipients%>">
            <span>Recipients</span>
        </li>
    <% end %>

    <%# Gift Ideas %>
    <%= link_to list_gifts_path, class: 'nav-link', id: "gift-ideas-link" do %>
        <li class="nav-item <%='active' if page == :gift_ideas %>">
            <span>Gift Ideas</span>
        </li>
    <% end %>

