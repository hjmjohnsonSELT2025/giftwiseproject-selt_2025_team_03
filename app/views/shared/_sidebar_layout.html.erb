<!-- Sidebar -->
<aside class="sidebar">
<div class="logo">
    <div class="logo-icon"></div>
    <span>GiftWise</span>
</div>

<nav>
    <ul class="nav-menu">
    <%# Dashboard %>
    <%= link_to dashboard_path class: 'nav-link' do %>
        <li class="nav-item<%= ' active' if current_page?(dashboard_path)%>">
            <span>Dashboard</span>
        </li>
    <% end %>


    <%# Events %>
    <%= link_to events_path class: 'nav-link'  do %>
        <li class="nav-item<%= ' active' if current_page?(events_path) || current_page?(new_event_path) || (controller_name == 'events')%>">
            <span>Events</span>
        </li>
      <% end %>


    <%# Recipients %>
    <%= link_to recipients_path class: "nav-link" do %>
        <li class="nav-item<%= ' active' if current_page?(recipients_path)%>">
            <span>Recipients</span>
        </li>
    <% end %>

    <%# Gift Ideas %>
    <%= link_to list_gifts_path class: 'nav-link' do %>
        <li class="nav-item<%= ' active' if current_page?(list_gifts_path)%>">
            <span>Gift Ideas</span>
        </li>
    <% end %>

