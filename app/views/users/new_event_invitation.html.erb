<%= form_with url: create_event_invitation_user_path(@user),
    method: :post,
    local: true do |f| %>

    <div class='header'>
        <div class='invite-header_left'>
            <h1>New Event Invitation</h1>
            <div class='decorative-line'></div>
        </div>
        <div class='invite-header_right'>
            <div class='user-invite-info'>
                <%= render @user, clickable: false %>
            </div>
        </div>
    </div>
    <%# Events %>
    <div class='field'>
        <fieldset>
            <legend>Events</legend>
            <div class='events-grid'>
                <%= f.collection_check_boxes :event_ids, @events, :id, :name do |e| %>
                    <label class='checkbox-row'>
                        <%= e.check_box %>
                        <span><%= e.text %></span>
                    </label>
                    <% end %>
                </div>
        </fieldset>
    </div>
    <div class='actions'>
        <%= f.submit "Send invitation(s)", class: "button primary" %>
        <%= link_to "Cancel", find_users_path, class: "button" %>
    </div>
<% end %>
