<%= turbo_frame_tag "users_list" do %>
  <% if users.present? %>
    <%= render partial: "users/user",
      collection: users,
      as: :user,
      locals: {
        clickable: true,
        invite_event: invite_event,
        show_actions: show_actions
      } %>
  <% else %>
    <% if last_query.present? %>
      <div class='hint'>No users found with the username "<%= last_query %>".</div>
    <% end %>
  <% end %>
<% end %>