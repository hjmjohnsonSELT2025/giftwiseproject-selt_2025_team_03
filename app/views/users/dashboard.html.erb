<%= render layout: 'shared/primary_layout' do %>
  <div class="top-right-profile">
    <button class="profile-button">Profile</button>
  </div>

  <div class="decorative-line"></div>
  <h1 class="sign-in-heading">Main Page</h1>

  <div class="button-group">
    <button class="nav-button">Events</button>
    <button class="nav-button">Recipients</button>
    <button class="nav-button">Gift Ideas</button>
    <button class="nav-button">Settings</button>

    <%= button_to "Logout",
                  logout_path,
                  method: :delete,
                  form_class: "logout-form",
                  class: "nav-button logout-button" %>
  </div>

  <h2 class="section-heading">Recent Activity</h2>
  <p class="recent-activity">No activity yet.</p>

<% end %>
