<%= render layout: 'shared/primary_layout' do %>
  <%= form_with model: @user, url: users_path, method: :post, class: "register-form" do |u| %>
    <div class="decorative-line"></div>

    <h1 class="register-heading">Register</h1>
    
    <div class="input-group">       <!--------------- First name --------------->
      <%= u.label :first_name, "First Name", name: "user[first_name]", class: "input-label" %>
      <%= u.text_field :first_name, max_length: 30, placeholder: "", class: "input-field required" %>
    </div>

    <div class="input-group">       <!--------------- Last name --------------->
      <%= u.label :last_name, "Last Name", class: "input-label" %>
      <%= u.text_field :last_name, max_length: 30, placeholder: "", class: "input-field required" %>
    </div>

    <div class="input-group">       <!--------------- Email --------------->
      <%= u.label :email, "Email", class: "input-label" %>
      <%= u.text_field :email, placeholder: "", class: "input-field email-field required" %>
    </div>

    <div class="input-group">       <!--------------- Username --------------->
      <%= u.label :username, "Username", class: "input-label" %>
      <%= u.text_field :username, placeholder: "", class: "input-field required" %>
    </div>

    <div class='input-group'>       <!--------------- Password --------------->
      <%= u.label :password, "Password", class: "input-label"%>
      <%= u.password_field :password, placeholder: "", class: "input-field required" %>
    </div>

    <div class='input-group'>       <!--------------- Confirm password --------------->
      <%= u.label :password_confirm, "Confirm password", class: "input-label" %>
      <%= u.password_field :password_confirm, placeholder: "", class: "input-field required" %>
    </div>

    <div class="input-group">       <!--------------- Birthday --------------->
      <%= u.label :birthday, "Birthday", class: "input-label" %>
      <%= u.date_field :birthday, value: Date.today, class: "input-field" %>
    </div>

    <%= u.submit "Create my account", class: "login-button" %>

    <div class="bottom-link">
      <p>Already have an account? <%= link_to "Login", login_path %></p>
    </div>
  <% end %>
<% end %>
<%= javascript_import_module_tag "controllers/users/new_user" %>