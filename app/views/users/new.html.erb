<%= render layout: 'shared/primary_layout' do %>
  <%= form_with model: @user, method: :post, class: "register-form" do |f| %>
    <div class="decorative-line"></div>

    <h1 class="register-heading">Register</h1>
    
    <div class="input-group">       <!--------------- First name --------------->
      <%= label_tag :first_name, "First Name", class: "input-label" %>
      <%= f.text_field :first_name, nil, max_length: 30, placeholder: "", class: "input-field required" %>
    </div>

    <div class="input-group">       <!--------------- Last name --------------->
      <%= label_tag :last_name, "Last Name", class: "input-label" %>
      <%= f.text_field :last_name, nil, max_length: 30, placeholder: "", class: "input-field required" %>
    </div>

    <div class="input-group">       <!--------------- Email --------------->
      <%= label_tag :email, "Email", class: "input-label" %>
      <%= f.text_field :email, nil, placeholder: "", class: "input-field email-field required" %>
    </div>

    <div class="input-group">       <!--------------- Username --------------->
      <%= label_tag :username, "Username", class: "input-label" %>
      <%= f.text_field :username, nil, placeholder: "", class: "input-field required" %>
    </div>

    <div class='input-group'>       <!--------------- Password --------------->
      <%= label_tag :password, "Password", class: "input-label"%>
      <%= f.password_field :password, nil, placeholder: "", class: "input-field required" %>
    </div>

    <div class='input-group'>       <!--------------- Confirm password --------------->
      <%= label_tag :password_confirm, "Confirm password", class: "input-label" %>
      <%= f.password_field :password_confirm, nil, placeholder: "", class: "input-field required" %>
    </div>

    <div class="input-group">       <!--------------- Birthday --------------->
      <%= label_tag :birthday, "Birthday", class: "input-label" %>
      <%= f.date_field :birthday, Date.today, class: "input-field" %>
    </div>

    <%= submit_tag "Create my account", class: "login-button" %>

    <div class="bottom-link">
      <p>Already have an account? <%= link_to "Login", login_path %></p>
    </div>
  <% end %>
<% end %>
<%= javascript_import_module_tag "controllers/users/new_user" %>