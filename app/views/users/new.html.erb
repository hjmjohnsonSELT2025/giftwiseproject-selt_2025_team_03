<%= render layout: 'shared/primary_layout' do %>
  <%= form_with url: users_path, method: :post, class: "register-form" do %>
    <div class="decorative-line"></div>

    <h1 class="register-heading">Register</h1>

    <div class="input-group">
      <%= label_tag :first_name, "First Name", class: "input-label" %>
      <%= text_field_tag :first_name, nil, max_length: 30, placeholder: "", class: "input-field required" %>
    </div>

    <div class="input-group">
      <%= label_tag :last_name, "Last Name", class: "input-label" %>
      <%= text_field_tag :last_name, nil, max_length: 30, placeholder: "", class: "input-field required" %>
    </div>

    <div class="input-group">
      <%= label_tag :email, "Email", class: "input-label" %>
      <%= text_field_tag :email, nil, placeholder: "", class: "input-field email-field required" %>
      <div class="email-info">
        <!-- Text to say "account w/ this email already exists or email available" -->
      </div>
    </div>

    <div class="input-group">
      <%= label_tag :birthday, "Birthday", class: "input-label" %>
      <%= date_field_tag :birthday, Date.today, class: "input-field" %>
    </div>

    <%= submit_tag "Create my account", class: "login-button" %>

    <div class="bottom-link">
      <p>Already have an account? <%= link_to "Login", login_path %></p>
    </div>
  <% end %>
<% end %>
<%= javascript_import_module_tag "controllers/users/new_user" %>