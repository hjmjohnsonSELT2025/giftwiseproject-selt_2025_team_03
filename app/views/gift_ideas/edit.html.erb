<%= render layout: 'shared/primary_layout' do %>
  <%= form_with model: @gift_idea, url: gift_ideas_path, method: :post, class: "register-form" do |u| %>
    <div class="decorative-line"></div>

    <h1 class="register-heading">Add a New Gift</h1>
    
    <div class="input-group">       <!--------------- Title --------------->
      <%= u.label :title, "Title", class: "input-label" %>
      <%= u.text_field :title, max_length: 30, placeholder: "#{@gift_idea.title}", class: "input-field required" %>
    </div>

    <div class="input-group">       <!--------------- Price --------------->
      <%= u.label :price, "Price", class: "input-label" %>
      <%= u.text_field :price, max_length: 30, placeholder: "#{@gift_idea.price}", class: "input-field required" %>
    </div>

    <div class="input-group">       <!--------------- Status --------------->
      <%= u.label :status, "Status", class: "input-label" %>
      <%= u.select :status, options_for_select(%w[idea backlogged purchased delivered wrapped liked]) %>
    </div>

    <div class="input-group">       <!--------------- Url --------------->
      <%= u.label :url, "Url Link", class: "input-label" %>
      <%= u.text_field :url, placeholder: "#{@gift_idea.url}", class: "input-field required" %>
    </div>

    <div class='input-group'>       <!--------------- Notes --------------->
      <%= u.label :notes, "Notes", class: "input-label"%>
      <%= u.text_field :notes, placeholder: "#{@gift_idea.notes}", class: "input-field required" %>
    </div>

    <div class='input-group'>       <!--------------- Recipient ID --------------->
      <%= u.label :event_recipient_id, "ID of the Recipient", class: "input-label" %>
      <%= u.text_field :event_recipient_id, placeholder: "#{@gift_idea.event_recipient_id}", class: "input-field required" %>
    </div>

    <%= u.submit "Create my gift", class: "login-button" %>
    <div class="login-button">
      <%= link_to 'Cancel', list_gifts_path%>
    </div>
  <% end %>
<% end %>
<%= javascript_import_module_tag "controllers/gift_ideas/edit_gift_idea" %>