<%= form_with model: @gift_idea,
        url: model_gifts_path,
        method: :get,
        data: {controller: "query-gift_idea"} do |f| %>
    <div class = 'form-header'>
        <h2 class='heading'>Generate Gift Ideas</h2>
        <div class='decorative-line'></div>
    </div>
    <div></div>

    <%# LLM Input Field %>
    <div class='input-group required'>
        <%= f.label :message, "Gift Input" %>
        <%= f.text_field :message, class: "input-field" %>
    </div>
    <div class='form-footer'>
        <%= link_to "Get Gift Ideas", gift_ideas_path, class: "button" %>
        <%= f.submit class: "button primary" %>
    </div>
    <!-- Change for this to be pass in from recipient profile here -->
  
    <!-- Will change to response, first confirm interactivity -->
    <div class='mb-3'>
        <%= f.label :message, "Gift Input" %>
        <%= f.text_field :message, class: "form-control-plaintext" %>
    </div>
    <!-- Change later to be per generated item -->
    <div>
        <%= form_with model: @gift_idea, url: obtain_gifts_path, method: :get, class: "gift-list-form" do |u| %>
            <%= submit_tag "Form as New Gift", class: "login-button" %>
        <% end %>
        <%= javascript_import_module_tag "controllers/gift_ideas/obtain" %>
    </div>
<% end %>