<%= render "shared/sidebar_layout" %>

<main class='main-content' data-controller="gift-ideas-search">
  <div class='top-bar'>
    <h1 class='page-title'>Gift Ideas</h1>
    <div class="top-bar__actions">
      <%= render 'shared/profile_dropdown' %>
    </div>
  </div>
  <%= link_to "AI suggestions", new_chat_path, class: "option option--sm", data: { turbo: false } %>


  <div class='view-options container'>
    <%= form_with url: search_gift_ideas_path,
                  method: :get,
                  data: {
                    controller: "gift-ideas",
                    turbo_frame: "gift_ideas_list"
                  },
                  class: "search-form" do %>
      <%= text_field_tag :query,
                         params[:query].to_s,
                         type: "search",
                         class: "input-field",
                         placeholder: "Search for gift ideas...",
                         data: {
                           "gift-ideas-search-target": "input",
                           action: "input->gift-ideas-search#search"
                         } %>
      <%= button_tag type: "submit", class: "search-button", title: "Search" do %>
        <%= icon :search, class: "icon" %>
      <% end %>
    <% end %>
  </div>

  <%# Template for a gift idea card %>
  <template id='gift-idea-card'>
    <div class='recipient-container view' data-gift-idea-id=''>
      <div class='col1'>
        <div class='recipient-header'>
          <div class='name' name='title'></div>
          <div class='ri' name='status'></div>
        </div>
        <div class='events'>
          <div class='detail-label'>Event & Recipient</div>
          <div class='details'>
            <div class='value' name='event-recipient'></div>
          </div>
        </div>
      </div>

      <div class='col2'>
        <div>
          <div class='detail-label'>Price</div>
          <div class='details' name='price'></div>
        </div>
        <div>
          <div class='detail-label'>Link</div>
          <div class='details' name='url'></div>
        </div>
        <% if false %>
          <div>
            <div class='detail-label'>Notes</div>
            <div class='details' name='notes'></div>
          </div>
        <% end %>
      </div>

      <div class='options'>
        <a href='#' class='option' data-action='edit'>
          <%= icon :edit, class: "icon" %>
        </a>
        <a href='#' class='option delete-link' data-action='delete'>
          <%= icon :trash, class: "icon" %>
        </a>
      </div>
    </div>
  </template>

  <%# Results container %>
  <div id='gift-idea-results' data-gift-ideas-search-target="results">
    <% if @gift_ideas.empty? %>
      <div class='empty-state'>
        <p>No gift ideas yet. Create your first gift idea to get started!</p>
      </div>
    <% else %>
      <% @gift_ideas.each do |gift_idea| %>
        <div class='recipient-container view' data-gift-idea-id='<%= gift_idea.id %>'>
          <div class='col1'>
            <div class='recipient-header'>
              <div class='name'><%= gift_idea.title %></div>
              <div class='ri'><%= gift_idea.status.titleize %></div>
            </div>

            <div class='events'>
              <div class='detail-label'>Event & Recipient</div>
              <div class='details'>
                <div class='value'>
                  <%= gift_idea.event_recipient&.event&.name || "No Event" %> →
                  <%= gift_idea.event_recipient&.recipient&.name || "No Recipient" %>
                </div>
              </div>
            </div>

            <% if gift_idea.notes.present? %>
              <div>
                <div class='detail-label'>Notes</div>
                <div class='details' style='color: rgba(255, 255, 255, 0.8);'>
                  <%= gift_idea.notes %>
                </div>
              </div>
            <% end %>
          </div>

          <div class='col2'>
            <div>
              <div class='detail-label'>Price</div>
              <div class='details'>$<%= number_to_currency(gift_idea.price || 0, unit: '') %></div>
            </div>

            <div>
              <div class='detail-label'>Link</div>
              <div class='details'>
                <% if gift_idea.url.present? %>
                  <%= link_to "View Product", gift_idea.url, target: "_blank", rel: "noopener", style: "color: var(--accent);" %>
                <% else %>
                  N/A
                <% end %>
              </div>
            </div>
          </div>

          <div class='options'>
            <%= link_to edit_gift_idea_path(gift_idea), class: "option" do %>
              <%= icon :edit, class: "icon" %>
            <% end %>

            <%= link_to gift_idea_path(gift_idea),
                        class: "option",
                        data: { turbo_method: :delete, turbo_confirm: "Delete #{gift_idea.title}?" } do %>
              <%= icon :trash, class: "icon" %>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</main>

<%= link_to "+", new_gift_idea_path, class: "add-button" %>