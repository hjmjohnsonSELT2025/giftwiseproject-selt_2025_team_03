<div class="dashboard-container">
  <!-- Sidebar -->
  <aside class="sidebar">
    <div class="logo">
      <div class="logo-icon"></div>
      <span>GiftWise</span>
    </div>

    <nav>
      <ul class="nav-menu">
        <li class="nav-item">
          <%= link_to 'Dashboard', dashboard_path, class: 'nav-link' %>
        </li>
        <li class="nav-item">
          <span>Events</span>
        </li>
        <li class="nav-item">
          <span>Recipients</span>
        </li>
        <li class="nav-item active">
          <span>Gift Ideas</span>
        </li>
        <li class="nav-item">
          <span>Purchases</span>
        </li>
        <li class="nav-item">
          <span>Settings</span>
        </li>
      </ul>
    </nav>
  </aside>

  <!-- Main List Content -->
  <main class="main-content">
    <!-- Gift Ideas List -->
    <div class="gifts-section">
      <div class="section-header">
        <h2 class="section-title">Upcoming Gifts</h2>
        <a href="#" class="view-all-link">View All →</a>
      </div>

      <% if !@uncoming_gifts.nil? and @upcoming_gifts.any? %>
        <% @upcoming_gifts.each do |gift| %>
          <div class="gift-card">
            <div class="gift-info">
              <div class="gift-name"><%= gift.title %></div>
              <div class="gift-date"><%= event.updated_at.strftime("%B %d, %Y") %></div>
              <div class="event-meta">
                <div class="meta-item">
                  <span><%= pluralize(event.days_until, 'day') %> left</span>
                </div>
                <div class="meta-item">
                  <span><%= pluralize(event.recipients.count, 'recipient') %></span>
                </div>
              </div>
            </div>
            <div class="circular-progress">
              <% percentage = event.budget_percentage %>
              <% degrees = (percentage * 3.6).round %>
              <div class="progress-ring" style="background: conic-gradient(var(--brown-accent) 0deg <%= degrees %>deg, rgba(157, 111, 87, 0.2) <%= degrees %>deg 360deg);">
                <div class="progress-inner">
                  <div class="progress-value">$<%= event.total_spent.round %></div>
                  <div class="progress-label">of $<%= event.budget.to_i %></div>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="empty-state">
          <p>No upcoming gifts or events. Create your first event or gift to get started!</p>
        </div>
      <% end %>
      <div class="gift-placeholder">
        <div class="gift-line"></div>
      </div>
    </div>
  </main>
</div>