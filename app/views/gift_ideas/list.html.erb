<!-- Sidebar -->
<%# Sidebar %>
<%= render "shared/sidebar_layout" %>

<main class="main-content">
  <div class='top-bar'>
    <h1 class='page-title'>Gift Ideas</h1>
    <%= render 'shared/profile_dropdown' %>
  </div>


  <div class='view-options container'>
    <input 
      type='text' 
      placeholder='Search for gift' 
      id='search-gifts' 
      class='input-field'
      data-search-url='<%= search_gifts_path %>'
    >
    <div class='container'>
        <div class='view-button' id='filter-option'>
            [Filter]
        </div>
        <div class='view-button' id='sort-option'>
            [Sort]
        </div>
    </div>
  </div>


  <div class="events-section">
    <% if !@upcoming_gifts.nil? and @upcoming_gifts.any? %>
      <% @upcoming_gifts.each do |gift| %>
        <div class="event-card">
          <div class="event-info">
            <div class="event-name"><%= gift.title %></div>
            <div class="event-date"><%= gift.updated_at.strftime("%B %d, %Y") %></div>
            <div class='recipient-options'>
              <a class='view-button edit-link' href='#'><%= image_tag "edit.png", alt: "Edit recipient", class: "icon" %></a>
              <a class='view-button delete-link' href='#'><%= image_tag "trash.png", alt: "Delete recipient", class: "icon" %></a>
            </div>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="empty-state">
        <p>No upcoming gifts or events. Create your first event or gift to get started!</p>
      </div>
    <% end %>
    <div class="event-placeholder">
      <div class="event-line"></div>
    </div>

    
    <%= form_with model: @gift_idea, url: add_gifts_path, method: :get, class: "gift-list-form" do |u| %>
      <%= submit_tag "New Gift", class: "login-button" %>
    <% end %>
    <%= javascript_import_module_tag "controllers/gift_ideas/add" %>
  </div>
</main>