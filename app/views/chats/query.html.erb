<%= render "shared/sidebar_layout" %>

<main class="main-content">
  <div class="top-bar">
    <h1 class="page-title">AI Gift Suggestions</h1>
    <%= render "shared/profile_dropdown" %>
  </div>

  <div class="container">
    <div class="hint">
      Event: <strong><%= @event.name %></strong>
      <span class="muted">•</span>
      Recipient: <strong><%= @recipient.name %></strong>
      <span class="muted">•</span>
      Budget: <strong><%= @event_recipient.budget || @event.budget || "—" %></strong>
    </div>

    <%= form_with url: query_chat_path, method: :get, data: { turbo: false }, class: "form" do %>
      <%= hidden_field_tag :event_recipient_id, @event_recipient.id %>

      <div class="input-group full-width">
        <%= label_tag :query, "Request", class: "input-label" %>
        <%= text_area_tag :query, @last_query, rows: 4, class: "input-field",
            placeholder: "e.g., under $25, practical, ships fast" %>
      </div>

      <div class="actions-row">
        <%= submit_tag "Generate suggestion", class: "button primary" %>
        <%= link_to "Change selection", new_chat_path, class: "button" %>
      </div>
    <% end %>

    <% if @gift.present? %>
      <% notes_text = (@gift[:notes].is_a?(Array) ? @gift[:notes].join("\n") : @gift[:notes].to_s) %>

      <div class="detail-section" style="margin-top: 18px;">
        <h2 style="margin: 0 0 10px 0;">Suggestion</h2>

        <div class="details" style="gap: 6px;">
          <div><strong><%= @gift[:title] %></strong></div>
          <% if @gift[:price].present? %><div>Price: <%= @gift[:price] %></div><% end %>
          <% if @gift[:url].present? %><div>URL: <%= @gift[:url] %></div><% end %>
          <% if notes_text.present? %>
            <div style="white-space: pre-wrap;">Notes:
<%= notes_text %>
            </div>
          <% end %>
        </div>

        <div style="margin-top: 12px;">
          <%= form_with url: gift_ideas_path(event_recipient_id: @event_recipient.id), method: :post,
                data: { turbo: false }, class: "form" do %>
            <%= hidden_field_tag "gift_idea[title]", @gift[:title] %>
            <%= hidden_field_tag "gift_idea[price]", @gift[:price] %>
            <%= hidden_field_tag "gift_idea[url]", @gift[:url] %>
            <%= hidden_field_tag "gift_idea[notes]", notes_text %>
            <%= hidden_field_tag "gift_idea[status]", "idea" %>
            <%= submit_tag "Save to Gift Ideas", class: "button primary" %>
          <% end %>
        </div>
      </div>
    <% elsif @last_query.present? %>
      <div class="hint" style="margin-top: 18px;">
        No structured suggestion returned. See server logs for raw model output.
      </div>
    <% end %>
  </div>
</main>
