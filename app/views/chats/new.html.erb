<%= render "shared/sidebar_layout" %>

<main class="main-content">
  <div class="top-bar">
    <h1 class="page-title">AI Gift Suggestions</h1>
    <%= render "shared/profile_dropdown" %>
  </div>

  <div class="container">
    <% if @event_recipients.present? %>
      <%= form_with url: query_chat_path, method: :get, data: { turbo: false }, class: "form" do %>
        <div class="input-group full-width">
          <%= label_tag :event_recipient_id, "Event + Recipient", class: "input-label" %>
          <%= select_tag :event_recipient_id,
                options_from_collection_for_select(
                  @event_recipients,
                  :id,
                  ->(er) { "#{er.event.name} — #{er.recipient.name}" },
                  params[:event_recipient_id]
                ),
                include_blank: "Select…",
                class: "input-field" %>
        </div>

        <div class="input-group full-width">
          <%= label_tag :query, "What kind of gift?", class: "input-label" %>
          <%= text_area_tag :query,
                params[:query],
                rows: 4,
                placeholder: "e.g., under $30, practical, not clothing, ships fast",
                class: "input-field" %>
        </div>

        <div class="actions">
          <%= button_tag "Get suggestion", type: "submit", class: "button primary" %>
        </div>
      <% end %>
    <% else %>
      <div class="hint">No event recipients yet. Add a recipient to an event first, then come back here.</div>
    <% end %>
  </div>
</main>
