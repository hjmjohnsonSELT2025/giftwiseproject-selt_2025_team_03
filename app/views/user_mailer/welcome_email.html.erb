<div style="font-family: Arial, sans-serif; max-width: 600px; margin: auto; padding: 20px; border: 1px solid #ddd; border-radius: 10px;">

  <h1 style="color: #4CAF50; text-align: center;">
    Welcome, <%= @user.first_name %>! 😁
  </h1>

  <p style="font-size: 16px; line-height: 1.6;">
    Thanks for joining <strong>GiftWise</strong> — we're excited to have you here!
    Your account has been successfully created, and you're set to get started.
  </p>

  <p style="font-size: 18px; line-height: 1.6;">
    Whenever you're ready, click below to log in:
  </p>

  <div style="text-align: center; margin: 30px 0;">
    <a href="<%= @url %>"
       style="background-color: #4CAF50; color: white; padding: 12px 20px; text-decoration: none; font-size: 16px; border-radius: 5px;">
      Log In to Your Account
    </a>
  </div>

</div>
